custom_target(
    'main.js',
    input: ['main.js', bundle_target[0], lite_exe, 'main.js'],
    output: ['main.js', 'main.js.map'],
    depends: [bundle_target],
    depend_files: ['zipfile.js', 'interop.js'],
    install: true,
    install_dir: lite_bindir,
    install_tag: ['shell'],
    command: [
        esbuild_exe,
        '--bundle',
        '--minify',
        '--target=es2017',
        '@INPUT0@',
        '--alias:asset-loader=./@INPUT1@',
        '--alias:lite-xl=./@INPUT2@',
        '--outfile=@OUTPUT0@',
        '--sourcemap=linked',
    ],
)

custom_target(
    'advanced.js',
    input: 'advanced.js',
    output: 'advanced.js',
    build_by_default: true,
    install: true,
    install_dir: lite_bindir,
    install_tag: ['shell'],
    command: [
        esbuild_exe,
        '--bundle',
        '--minify',
        '--target=es2017',
        '@INPUT0@',
        '--outfile=@OUTPUT@',
        '--sourcemap=linked',
    ],
)